#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;

    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    if (n == 2) {
        cout << a[0] + a[1] << "\n";
        return;
    }

    sort(a.begin(), a.end());

    int combined = a[0] + a[1];
    int ans = max(a[n - 1], combined);

    cout << ans << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    if(cin >> t){
        while (t--){
            solve();
        }
    }
    return 0;
}
