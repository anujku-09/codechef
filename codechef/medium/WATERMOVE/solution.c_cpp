#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, k;
    cin >> n >> k;

    vector<long long> a(n);
    long long sum = 0;
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        sum += a[i];
    }

    if(k >= n - 1){
        cout << sum << "\n";
        return;
    }
    sort(a.begin(), a.end());
    int rem = n - k;
    long long ans = 0;

    for (int i = 0; i < rem - 1; i++){
        ans = max(ans, a[k + 1 + i]);
    }
    
    long long prefix = 0;
    for (int i = 0; i <= k; i++) {
        prefix += a[i];
    }
    ans = max(ans, prefix);
    cout << ans << endl;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    if(cin >> t){
        while (t--){
            solve();
        }
    }
    return 0;
}
