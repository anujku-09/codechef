#include <bits/stdc++.h>
using namespace std;

vector<int> adj[2005];
int color[2005];

bool dfs(int u, int c) {
    color[u] = c;
    for (int v : adj[u]) {
        if (color[v] == -1 && !dfs(v, 1 - c)) return false;
        if (color[v] == c) return false;
    }
    return true;
}

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, m;
        cin >> n >> m;
        for (int i = 1; i <= n; i++) {
            adj[i].clear();
            color[i] = -1;
        }
        while (m--) {
            int u, v;
            cin >> u >> v;
            adj[u].push_back(v);
            adj[v].push_back(u);
        }
        bool ok = true;
        for (int i = 1; i <= n; i++) {
            if (color[i] == -1 && !dfs(i, 0)) ok = false;
        }
        cout << (ok ? "YES\n" : "NO\n");
    }
}