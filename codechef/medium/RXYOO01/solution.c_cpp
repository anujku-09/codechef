int findLongestPalindromicSubsequenceLength(string inputString) {
    int n = inputString.size();
    if(n== 0)  return 0;
     vector<int> dp(n, 0);
     for(int i = n - 1; i >= 0; i--) {
         dp[i] = 1;
         int prev = 0;
         for(int j = i + 1; j < n; j++) {
             int temp = dp[j];
             if(inputString[i] == inputString[j]) {
                 dp[j] = 2 + prev;
             } else {
                 dp[j] = max(dp[j], dp[j - 1]);
             }
             prev = temp;
         }
     }
    return dp[n-1];
}