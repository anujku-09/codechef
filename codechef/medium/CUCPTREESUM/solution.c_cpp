#include <bits/stdc++.h>
using namespace std;

vector<vector<int>> adj;
vector<int> subtree;
vector<long long> ans;
int n;

void dfs1(int u, int parent, int depth) {
    subtree[u] = 1;
    ans[1] += depth;

    for (int v : adj[u]) {
        if (v == parent)
            continue;

        dfs1(v, u, depth + 1);
        subtree[u] += subtree[v];
    }
}

void dfs2(int u, int parent) {
    for (int v : adj[u]) {
        if (v == parent)
            continue;

        ans[v] = ans[u] - subtree[v] + (n - subtree[v]);
        dfs2(v, u);
    }
}

int main() {
    cin >> n;

    adj.resize(n + 1);
    subtree.resize(n + 1);
    ans.resize(n + 1, 0);

    for (int i = 0; i < n - 1; i++) {
        int u, v;
        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    dfs1(1, 0, 0);
    dfs2(1, 0);

    for (int i = 1; i <= n; i++) {
        cout << ans[i] << '\n';
    }

    return 0;
}

