#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, s;
    cin >> n >> s;
    int c[n];
    for (int i = 0; i < n; i++) {
        cin >> c[i];
    }
    vector<int> dp(s + 1, 1000000);
    dp[0] = 0;
    for (int i = 1; i <= s; i++){
        for (int j = 0; j < n; j++){
            if (c[j] <= i) {
                dp[i] = min(dp[i],dp[i - c[j]] + 1);
            }
        }
    }
    if(dp[s] == 1000000) {
        cout << -1 << endl;
    } 
    else{
        cout << dp[s] << endl;
    }
}
