#include <bits/stdc++.h>
using namespace std;

bool pal(string &s, int l, int r) {
    while (l < r)
        if (s[l++] != s[r--]) return false;
    return true;
}

int main() {
    int n;
    string s;
    cin >> n >> s;
    int l = 0, r = n - 1;
    while (l < r && s[l] == s[r]) l++, r--;
    cout << (pal(s, l + 1, r) || pal(s, l, r - 1) ? "true" : "false");
}