#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin >> t;
	while(t--){
	    int n;
	    cin >> n;
	    long long sum = 0;
	    int mini = INT_MAX;
	    for(int i = 0; i < n; i++){
	        int x;
	        cin >> x;
	        sum += x;
	        mini = min(mini, x);
	    }
	    cout << sum - mini << endl;
	}
	return 0;
}
