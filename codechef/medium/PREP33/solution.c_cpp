#include <bits/stdc++.h>
using namespace std;

void solve() {
    string s;
    cin >> s;
    int n = s.size();
    
    vector<int> dp(n, 0);
    int mx_len = 0;
    
    for(int i = 0; i < n; i++) {
        if(s[i] == ')') {
            if(s[i - 1] == '(') {
                dp[i] = (i >= 2 ? dp[i - 2] : 0) + 2;
            } else if (i - dp[i - 1] > 0 && s[i - dp[i - 1] - 1] =='(') {
                dp[i] = dp[i - 1] + 2 + ((i - dp[i - 1] >= 2) ? dp[i - dp[i- 1] - 2] : 0);
            }
            mx_len = max(mx_len, dp[i]);
        }
    }
    cout << mx_len << endl;
}

int main() {
	int t;
	cin >> t;
	while(t--) {
	    solve();
	}
}
