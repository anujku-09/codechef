#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin >> t;
	while(t--) {
	  int n; 
	  cin >> n;
	  string s;
	  cin >> s;
	  
	  int first = -1;
	  int last = 0;
	  for(int i = 0; i < n; i++) {
	    if(s[i] == '1' && first == -1) {
	      first = i;
	    }
	    if(s[i] == '0') {
	      last = i;
	    }
	  }
	  int ans = 0;
	  if(first != -1 && last > first) {
	    ans = last - first;
	  }
	  cout << ans << endl;
	}
}
