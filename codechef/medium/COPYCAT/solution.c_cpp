#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin >> t;
	while(t--) {
	  int n; 
	  cin >> n;
	  string s;
	  cin >> s;
	  
	  int last = -1;
	  int ans = 0;
	  for(int i = 0; i < n; i++) {
	    if(s[i] == '0') {
	      last = i;
	    }
	   }
	  for(int i = 0; i < last; i++) {
	    if(s[i] == '1') {
	      ans++;
	    }
	  }
	  cout << ans << endl;
	}
}
