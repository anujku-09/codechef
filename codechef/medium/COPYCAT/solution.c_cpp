#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin >> t;
	while(t--) {
	  int n; 
	  cin >> n;
	  string s;
	  cin >> s;
	  
	  int ans = 0;
	  int i = 0;
	  while(i < n && s[i] == '0') {
	    i++;
	  }
	  while(i < n && s[i] == '1') {
	    ans++;
	    i++;
	  }
	  cout << ans << endl;
	}
}
