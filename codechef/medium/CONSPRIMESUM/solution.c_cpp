#include <bits/stdc++.h>
using namespace std;

int main() {
	int n;
	if(!(cin >> n)) return 0;
	vector<bool> isPrime(n + 1, true);
	isPrime[0] = isPrime[1] = false;
	
	for(int p = 2; p * p <= n; p++) {
	    if(isPrime[p]){
	        for(int i = p * p; i <= n; i += p){
	            isPrime[i] = false;
	        }
	    }
	}
	
	vector<int> primes;
	for(int p = 2; p <= n; p++){
	    if(isPrime[p]){
	        primes.push_back(p);
	    }
	}
	
	long long sum = 0;
	int cnt = 0;
	for(int i = 0; i < primes.size(); i++){
	    sum += primes[i];
	    if(sum > n){
	        break;
	    }
	    if(i >= 1 && isPrime[sum]) {
	        cnt++;
	    }
	}
	cout << cnt << "\n";
}
