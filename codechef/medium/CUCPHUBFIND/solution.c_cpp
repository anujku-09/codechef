#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int u1, v1, u2, v2;
    cin >> u1 >> v1 >> u2 >> v2;

    if (u1 == u2 || u1 == v2) {
        cout << u1 << "\n";
    } else {
        cout << v1 << "\n";
    }

    for (int i = 0; i < n - 3; i++) {
        int u, v;
        cin >> u >> v;
    }

    return 0;
}