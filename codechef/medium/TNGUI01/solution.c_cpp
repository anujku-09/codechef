int countDistinctSubsequences(string sourceString, string targetString) {
    int n = sourceString.size();
    int m = targetString.size();
    if(m > n) {
        return 0;
    }
    vector<int> dp (m + 1, 0);
    dp[0] = 1;
    for(int i = 0; i < n; i++) {
        for(int j = min(i + 1, m); j >= 1;j--) {
            if(sourceString[i] == targetString[j - 1]) {
                dp[j] += dp[j - 1];
            }
        }
    }
    return dp[m];
}