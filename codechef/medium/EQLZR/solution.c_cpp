#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < long long > a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        int ans = 0;

        for (int i = 0; i < n - 1; i++) {
            if (a[i] == a[i + 1]) {
                ans++;
            }
        }
        int extra = 0;
        
        for(int i = 0; i < n; i++) {
            int gain = 0;
            if(i > 0 && a[i - 1] == a[i] + 1 ) {
                gain++;
            }
            if(i < n - 1 && a[i + 1] == a[i] + 1){
                gain++;
            }
            extra = max(extra, gain);
        }
        cout << ans + extra << endl;
    }
}