#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < long long > a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        int ans = 0;

        for (int i = 0; i < n - 1; i++) {
            if (a[i] == a[i + 1]) {
                ans++;
            }
        }
        for (int l = 0; l < n; l++) {
            for (int r = l; r < n; r++) {
                int score = 0;

                for (int i = 0; i < n - 1; i++) {
                    long long x = a[i];
                    long long y = a[i + 1];
                    if (i >= l && i <= r) {
                        x++;
                    }
                    if(i + 1 >= l && i + 1 <= r){
                        y++;
                    }
                    if(x == y{
                        score++;
                    }
                }
                ans = max(ans, score);
            }
        }
        cout << ans << endl;
    }
}