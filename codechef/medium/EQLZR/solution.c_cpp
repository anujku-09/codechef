#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < long long > a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        int ans = 0;

        for (int i = 0; i < n - 1; i++) {
            if (a[i] == a[i + 1]) {
                ans++;
            }
        }
        vector<int> left(n, 0), right(n, 0);

        for(int i = 1; i < n; i++){
            if (a[i - 1] == a[i] + 1){
                left[i] = 1;
            }
            if (a[i - 1] == a[i]) {
                left[i]--;
            }
        }

        for(int i = 0; i < n - 1; i++){
            if (a[i] + 1 == a[i + 1]) {
                right[i] = 1;
            }
            if (a[i] == a[i + 1]) {
                right[i]--;
            }
        }
        int best = 0;
        int maxLeft = left[0];

        for(int r = 0; r < n; r++) {
            maxLeft = max(maxLeft, left[r]);
            best = max(best, maxLeft + right[r]);
        }

        cout << ans + best << endl;
    }
}