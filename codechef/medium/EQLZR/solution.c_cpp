#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector < long long > a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }
        int ans = 0;

        for (int i = 0; i < n - 1; i++) {
            if (a[i] == a[i + 1]) {
                ans++;
            }
        }
        int extra = 0;
        
        for(int i = 0; i < n - 1; i++) {
            if(a[i] + 1 == a[i + 1]) {
                extra = max(extra, 1);
            }
            if(a[i] == a[i + 1] + 1){
                extra = max(extra, 1);
            }
        }
        cout << ans << endl;
    }
}