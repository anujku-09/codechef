class Solution {
public:
    int totalFruits(vector<int>& fruits) {
        unordered_map<int, int> basket;
        int mx_fruits = 0;
        int l = 0;
        for(int r = 0; r < fruits.size(); r++){
            basket[fruits[r]]++;
            
            while(basket.size() > 2){
                basket[fruits[l]]--;
                if(basket[fruits[l]] == 0){
                    basket.erase(fruits[l]);
                }
                l++;
            }
            mx_fruits = max(mx_fruits, r - l + 1);
        }
        return mx_fruits;
    }
};
