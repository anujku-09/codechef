#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--){
        int n;
        cin >> n;
        int a[n];
        for(int i = 0; i <n; i++){
            cin >> a[i];
        }
        int cnt = 0;
        for(int i = 0; i < n; i++){
            bool good = true;
            for(int j = max(0, i - 5); j < i; j++){
                if(a[i] >= a[j]) {
                    good = false;
                    break;
                }
            }
            if(good){
                cnt++;
            }
        }
        cout << cnt << endl;
    }

}
