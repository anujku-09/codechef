#include <bits/stdc++.h>
using namespace std;

void solve() {
    string a, b;
    cin >> a >> b;
    
    int n = a.size();
    int m = b.size();
    
    vector<int> dp(m + 1);
    for(int j = 0; j <= m; j++) {
        dp[j] = j;
    }
    for(int i = 1; i <= n; i++) {
        int prev = dp[0];
        dp[0] = i;
        
        for(int j = 1; j<= m; j++) {
            int temp = dp[j];
            if(a[i - 1] == b[j - 1]) {
                dp[j] = prev;
            } else {
                dp[j] = 1 + min({dp[j], dp[j - 1], prev});
            }
            prev = temp;
        }
    }
    cout << dp[m] << endl;
}

int main() {
	int t;
	cin >> t;
	while(t--) {
	    solve();
	}
}
