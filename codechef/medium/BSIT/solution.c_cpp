#include <bits/stdc++.h>
using namespace std;

const long long MOD = 1000000007LL;
struct SegmentTree {
    int size;
    vector<int> tree;

    SegmentTree(int n) {
        size = 1;
        while (size < n) size <<= 1;
        tree.assign(2 * size, -1);
    }

    void update(int pos, int value) {
        pos += size;
        tree[pos] = value;

        for (pos >>= 1; pos > 0; pos >>= 1) {
            tree[pos] = max(tree[pos << 1],
                            tree[pos << 1 | 1]);
        }
    }

    int query(int left, int right) {
        int result = -1;
        left += size;
        right += size;

        while (left < right) {
            if (left & 1)
                result = max(result, tree[left++]);

            if (right & 1)
                result = max(result, tree[--right]);

            left >>= 1;
            right >>= 1;
        }

        return result;
    }
};

struct Frame {
    int u;
    int childIndex;
    int oldLast;
    int oldLeft;
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<vector<int>> child(n + 1);
    vector<int> parent(n + 1);

    for (int i = 1; i <= n; i++) {
        cin >> parent[i];

        if (parent[i] != 0) {
            child[parent[i]].push_back(i);
        }
    }

    vector<int> color(n + 1);

    for (int i = 1; i <= n; i++) {
        cin >> color[i];
    }

    int q;
    cin >> q;

    vector<int> queries(q);

    for (int i = 0; i < q; i++) {
        cin >> queries[i];
    }

    // Coordinate-compress colors.
    vector<int> values(color.begin() + 1, color.end());
    sort(values.begin(), values.end());

    values.erase(
        unique(values.begin(), values.end()),
        values.end()
    );

    for (int i = 1; i <= n; i++) {
        color[i] = lower_bound(
            values.begin(), values.end(), color[i]
        ) - values.begin();
    }

    vector<int> depth(n + 1, 0);
    vector<int> tin(n + 1), tout(n + 1);
    vector<int> leftBound(n + 1, 0);
    vector<int> euler(n);

    int timer = 0;
    int currentLeft = 0;

    unordered_map<int, int> lastSeen;
    lastSeen.reserve(2 * n);
    lastSeen.max_load_factor(0.7);

    vector<Frame> dfs;
    dfs.reserve(n);

    tin[1] = timer;
    euler[timer++] = 1;
    lastSeen[color[1]] = 0;
    leftBound[1] = 0;

    dfs.push_back({1, 0, -1, 0});
    while (!dfs.empty()) {
        Frame &f = dfs.back();
        int u = f.u;

        if (f.childIndex < (int)child[u].size()) {
            int v = child[u][f.childIndex++];

            depth[v] = depth[u] + 1;

            int oldLeft = currentLeft;
            int oldLast = -1;

            auto it = lastSeen.find(color[v]);

            if (it != lastSeen.end()) {
                oldLast = it->second;
                currentLeft = max(currentLeft, oldLast + 1);
            }

            leftBound[v] = currentLeft;

            tin[v] = timer;
            euler[timer++] = v;

            lastSeen[color[v]] = depth[v];

            dfs.push_back({
                v, 0, oldLast, oldLeft
            });
        } else {
            tout[u] = timer;

            int oldLast = f.oldLast;
            int oldLeft = f.oldLeft;

            if (oldLast == -1) {
                lastSeen.erase(color[u]);
            } else {
                lastSeen[color[u]] = oldLast;
            }

            currentLeft = oldLeft;
            dfs.pop_back();
        }
    }

    vector<int> nodes(n);
    iota(nodes.begin(), nodes.end(), 1);

    sort(nodes.begin(), nodes.end(), [&](int a, int b) {
        return leftBound[a] < leftBound[b];
    });

    vector<int> queryOrder(n);
    iota(queryOrder.begin(), queryOrder.end(), 1);

    sort(queryOrder.begin(), queryOrder.end(),
         [&](int a, int b) {
             return depth[a] < depth[b];
         });

    SegmentTree seg(n);

    vector<int> best(n + 1, 1);
    int ptr = 0;

    for (int x : queryOrder) {
        // Activate nodes whose root-path suffix starts
        // no later than depth[x].
        while (ptr < n &&
               leftBound[nodes[ptr]] <= depth[x]) {
            int v = nodes[ptr++];
            seg.update(tin[v], depth[v]);
        }

        // Find the deepest valid descendant of x.
        int maxDepth = seg.query(tin[x], tout[x]);

        best[x] = maxDepth - depth[x] + 1;
    }

    long long result = 0;

    for (int x : queries) {
        result = (result + best[x]) % MOD;
    }
    cout << result << '\n';
    return 0;
}
