#include <bits/stdc++.h>
using namespace std;

void solve(){
    int n;
    cin >> n;
    vector<int> a(n);
    for(int i = 0; i < n; i++){
        cin >> a[i];
    }
    vector<int> res;
    for(int i = 0; i < n; i++){
        if(i == 0 || a[i] != a[i - 1]){
            res.push_back(a[i]);
        }
    }
    cout << res.size() << "\n";
    for(int i = 0; i < (int)res.size(); i++){
        cout << res[i] << " ";
    }
    cout << "\n";
}

int main() {
	int t;
	cin >> t;
	while(t--){
	    solve();
	}
	return 0;
}
