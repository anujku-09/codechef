#include <bits/stdc++.h>
using namespace std;

int main() {
    string s;
    getline(cin, s);

    int f[26] = {0};
    for (char c : s) {
        if (isalpha(c)) f[tolower(c) - 'a']++;
    }

    char ans = 'a';
    for (int i = 0; i < 26; i++) {
        if (f[i] > f[ans - 'a']) ans = 'a' + i;
    }
    cout << ans << "\n";
}