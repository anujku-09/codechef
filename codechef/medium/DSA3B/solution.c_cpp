#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--){
        int n, x;
        cin >> n >> x;
        int a[n];
        for(int i = 0; i < n; i++){
            cin >> a[i];
        }
        for(int i = 0; i <= n - x; i++){
            int mx = a[i];
            for(int j = i + 1; j < i; j++){
                if(a[j] > mx){
                    mx = a[j];
                }
            }
            cout << mx << " ";
        }
        cout << endl;
    }
}
