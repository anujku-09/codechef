#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin >> t;
	while(t--) {
	    int n; long long m;
	    cin >> n >> m;

	int a[100];
	for(int i= 0; i < n; i++){
	    cin >> a[i];
	}
	sort(a, a+n);
	
	long long people = 0;
	int grps = 0;
	
	for(int i = 0; i < n; i++){
	    long long tot = people + a[i];
	    long long h_shake = tot * (tot - 1) / 2;
	    
	    if(h_shake <= m) {
	        people = tot;
	        grps++;
	    } else {
	        break;
	    }
	}
	cout << grps << endl;
	}
}
