#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int &x : a) cin >> x;

    int l = 0, ans = 0, zero_groups = 0;
    for (int r = 0; r < n; r++) {
        if (a[r] == 0 && (r == 0 || a[r - 1] == 1)) zero_groups++;
        while (zero_groups > 1) {
            if (a[l] == 0 && a[l + 1] == 1) zero_groups--;
            l++;
        }
        ans = max(ans, r - l + 1);
    }
    cout << (zero_groups == 0 ? n - 1 : ans) << "\n";
}