#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> d(n);
    for (int i = 0; i < n; i++) cin >> d[i];

    for (int i = n - 1; i >= 0; i--) {
        if (d[i] < 9) {
            d[i]++;
            for (int x : d) cout << x << " ";
            return 0;
        }
        d[i] = 0;
    }

    cout << 1 << " ";
    for (int x : d) cout << x << " ";
}