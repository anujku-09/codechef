class Solution {
public:
    int longestUniqueSubstring(string s) {
        int mp[256] = {0}, l = 0, ans = 0;
        for (int r = 0; r < s.size(); r++) {
            mp[s[r]]++;
            while (mp[s[r]] > 1) mp[s[l++]]--;
            ans = max(ans, r - l + 1);
        }
        return ans;
    }
};