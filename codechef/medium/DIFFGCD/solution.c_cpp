#include <bits/stdc++.h>
using namespace std;

void solve() {
    long long n;
    cin >> n;

    long long max_d = n / 2;
    long long total = 0;

    long long left = 1;
    while (left <= max_d) {
        long long val = n / left;
        long long right = n / val;
        
        if (right > max_d) {
            right = max_d;
        }

        long long count = right - left + 1;
        total += count * (val - 1);

        left = right + 1;
    }

    cout << total << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    if (cin >> t) {
        while (t--) {
            solve();
        }
    }
    return 0;
}
