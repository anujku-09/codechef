#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while(t--){
        long long n;
        cin >> n;
        long long sum = 0;
        long long l = 1;
        while(sum + l <= n){
            sum += l;
            l++;
        }
        cout << l - 1 <<endl;
    }
    return 0;
}