#include <bits/stdc++.h>
using namespace std;

int main() {
	int n, m;
	cin >> n >> m;
	vector<int> a(n);
	int mx = 0;
	for(int i = 0; i < n; i++){
	    cin >> a[i];
	    mx = max(mx, a[i]);
	}
	vector<int> b(m), cost(m);
	for(int i = 0; i < m; i++){
	    cin >> b[i];
	}
	for(int i = 0; i < m; i++){
	    cin >> cost[i];
	}
	const int INF = 1e9;
	vector<int> dp(mx + 1, INF);
	dp[0] = 0;
	for(int x = 1; x <= mx; x++){
	    for(int j = 0; j < m; j++){
	        if(x >= b[j] && dp[x - b[j]] != INF){
	            dp[x] = min(dp[x], dp[x -b[j]] + cost[j]);
	        }
	    }
	}
	long long ans = 0;
	for(int x : a){
	    ans += dp[x];
	}
	cout << ans << endl;
}
