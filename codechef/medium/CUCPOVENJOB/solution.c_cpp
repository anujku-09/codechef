#include <bits/stdc++.h>
using namespace std;

int main() {
	int m, n;
	cin >> m >> n;
	vector<int> freq(26, 0);
	for(int i = 0; i < m; i++){
	    char ch;
	    cin >> ch;
	    freq[ch - 'A']++;
	}
	int max_freq = 0;
	for(int cnt : freq){
	    max_freq = max(max_freq, cnt);
	}
	int max_freq_cnt = 0;
	for(int cnt : freq){
	    if(cnt == max_freq){
	        max_freq_cnt++;
	    }
	}
	int ans = (max_freq - 1) * (n + 1) + max_freq_cnt;
	ans = max(ans, m);
	cout << ans << "\n";
	return 0;
}
