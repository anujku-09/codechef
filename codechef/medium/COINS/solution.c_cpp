#include <bits/stdc++.h>
using namespace std;

unordered_map<long long, long long> memo;

long long solve(long long n){
    if(n < 12) {
        return n;
    }
    if(memo.count(n)) {
        return memo[n];
    }
    long long exch = solve(n / 2) + solve(n/ 3) +solve(n / 4);
    
    return memo[n] = max(n, exch);
}

int main() {
	long long n;
	while(cin >> n) {
	    cout << solve(n) << "\n";
	}
	return 0;
}
