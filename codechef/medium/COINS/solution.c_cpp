#include <bits/stdc++.h>
using namespace std;

unordered_map<long long, long long> dp;

long long solve(long long n) {
    if (n < 12) {
        return n;
    }
    if (dp.count(n)) {
        return dp[n];
    }
    long long exchange = solve(n / 2) + solve(n / 3) + solve(n / 4);
    return dp[n] = max(n, exchange);
}

int main() {
    long long n;
    while (cin >> n) {
        cout << solve(n) << endl;
    }
    return 0;
}
