#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin >> t;
	while(t--) {
	  int n;
	  cin >> n;
	  int a[100];
	  for(int i = 0; i < n; i++) {
	    cin >> a[i];
	  }
	  sort(a, a + n);
	  int cnt = 0;
	  
	  for(int i = 0; i < n; i++) {
	    int j = i;
	    while(j + 1 < n && a[ j + 1] == a[i]) j++;
	    if(j + 1 > n - j - 1) cnt += j - i + 1;
	    i = j;
	  }
	  cout << cnt << endl;
	}
}
