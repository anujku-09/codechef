#include <bits/stdc++.h>
using namespace std;

void run(){
    int n, k;
    cin >> n >> k;

    vector<long long> a(n);
    long long total = 0;
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        total += a[i];
    }
    if (k >= n - 1) {
        cout << total << "\n";
        return;
    }

    sort(a.rbegin(), a.rend());
    long long ans = 0;
    for (int i = 0; i <= k; i++) {
        ans += a[i];
    }
    cout << ans << endl;
}

int main() {
	ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    if(cin >> t){
        while(t--){
            run();
        }
    }
    return 0;
}
