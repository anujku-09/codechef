#include <bits/stdc++.h>
using namespace std;

int solve(string s, int k) {
    if (s.size() < k) return 0;
    int f[26] = {0};
    for (char c : s) f[c - 'a']++;

    for (int i = 0; i < s.size(); i++) {
        if (f[s[i] - 'a'] < k) {
            int j = i + 1;
            while (j < s.size() && f[s[j] - 'a'] < k) j++;
            return max(solve(s.substr(0, i), k), solve(s.substr(j), k));
        }
    }
    return s.size();
}

int main() {
    int n, k;
    string s;
    cin >> n >> k >> s;
    cout << solve(s, k) << "\n";
}