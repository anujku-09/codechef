#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
	long int n;
	double sqnum;
	long int i, j = 0, chksqr;
	vector<long int> temp;
	int cnt = 0, k;
	
	cin >> n;
	
	for(i = 2; i <= n /2; i++) {
	    if(n % i == 0) {
	        cnt++;
	        sqnum = sqrt(i);
	        chksqr = sqnum;
	        
	        if(chksqr == sqnum) {
	            cnt--;
	            temp.push_back(i);
	            j++;
	        }
	        else{
	            for(k = 0; k < j; k++) {
	                if(i > temp[k] && j != 0) {
	                    if(i % temp[k] == 0) {
	                        cnt--;
	                        k = j + 1;
	                    }
	                }
	                else{
	                    break;
	                }
	            }
	        }
	    }
	}
	cout << cnt << endl;
}
