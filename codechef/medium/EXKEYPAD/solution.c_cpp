#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin >> t;
	while(t--) {
	    long long n;
	    int d;
	    cin >> n >> d;
	    
	    while(true) {
	        string s = to_string(n);
	        int pos = -1;
	        for(int i = 0; i < s.size(); i++) {
	            if(s[i] == char('0' + d)) {
	                pos = i;
	                break;
	            }
	        }
	        if(pos == -1) {
	            cout << n << endl;
	            break;
	        }
	        bool chnge = false;
	        for(int i = pos; i >= 0; i--) {
	            if(s[i] < '9') {
	                s[i]++;
	                chnge = true;
	                break;
	            }
	            s[i] = '0';
	        }
	        if(!chnge) {
	            s = "1" + s;
	        }
	        for(int i = pos + 1; i < s.size(); i++) {
	            s[i] = '0';
	        }
	        
	        n = stoll(s);
	    }
	}
}
